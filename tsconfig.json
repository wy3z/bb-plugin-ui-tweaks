{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "app.tsx", "lib/**/*.ts", "test/**/*.ts"]
}
